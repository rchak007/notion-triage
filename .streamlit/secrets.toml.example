# Copy to .streamlit/secrets.toml (local) or paste into the Streamlit Cloud
# "Secrets" box. Never commit the real file — it's gitignored.

# --- WORKLL (Notion account/workspace #1) ---
NOTION_TOKEN_WORKLL = "ntn_your_workll_token"
NOTION_PAGE_WORKLL  = "your_workll_page_id"

# Notion

# --- OPA (Notion account/workspace #2 — make a SEPARATE connection there) ---
NOTION_TOKEN_OPA = "ntn_your_opa_token"
NOTION_PAGE_OPA  = "your_opa_page_id"



# --- Ask panel ---
#ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_API_KEY = "sk-ant-your_key"
# ASK_MODEL = "claude-sonnet-4-6"   # optional; bump to a higher tier if you like

# --- Digest email (digest.py) ---
# DIGEST_TO = "you@example.com"   # comma-separated; Gmail creds stay in market-tracker's .env

# --- Optional tuning (falls back to code defaults) ---
# PRIORITY_TIERS = "A1000:3,B1000:2,C1000:1"
# DUE_SOON_DAYS  = "7"
# STALE_DAYS     = "14"
